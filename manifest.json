{
  "manifest_version": 3,
  "name": "AI Video Script Cloner",
  "version": "1.0",
  "description": "Генератор сценариев и SEO напрямую из YouTube",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Сгенерировать сценарий"
  }
}
